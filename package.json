{
  "name": "visual-tennis-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api:fixtures": "node --use-env-proxy --env-file-if-exists=.env src/fixtures.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "api:live": "node --use-env-proxy --env-file-if-exists=.env src/live.ts",
    "api:live-list": "node --use-env-proxy --env-file-if-exists=.env src/live-list.ts",
    "api:validate": "node --use-env-proxy --env-file-if-exists=.env src/validate.ts",
    "replay": "node src/replay.ts",
    "dev": "node src/serve.ts",
    "feed:check": "node src/feed-check.ts",
    "format": "prettier --write src test package.json tsconfig.json README.md docs",
    "format:check": "prettier --check src test package.json tsconfig.json README.md docs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
